{
  "name": "project-archivist",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first ChatGPT archive toolkit with desktop app + Chrome extension",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "dev:desktop": "pnpm --filter @project-archivist/desktop dev",
    "dev:extension": "pnpm --filter @project-archivist/extension dev"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  }
}
